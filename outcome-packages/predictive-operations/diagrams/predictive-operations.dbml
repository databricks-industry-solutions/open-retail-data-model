  labor_risk string [note: 'Labor/workforce domain sub-score from gold_labor_risk (0-100). Present when Workforce Optimization / labor domain is …']
  cx_risk string [note: 'Customer-experience domain sub-score. DEFERRED — always NULL in v1 (no CX source yet).']
  domains_scored string [note: 'How many domains had a present (non-NULL) sub-score feeding the composite. Max is 5 (cx deferred); 0 means unscored …']
  operational_risk_tier string [note: 'Risk tier: UNKNOWN (no domain scored, domains_scored = 0), LOW, MEDIUM, HIGH, CRITICAL. Any single present domain going …']
  top_risk_domains string [note: 'Up-to-3 domains with the largest weighted contribution to the score (the Diagnose step).']
  Note: 'gold · gold'
}

Table gold_workforce_coverage_gap {
  store_sk string [note: 'Surrogate key for the store.']
  store_id string [note: 'Durable store business key.']
  business_date string [note: 'Local business date the interval belongs to.']
  interval_start_ts string [note: 'Inclusive start of the planning interval (UTC).']
  interval_end_ts string [note: 'Exclusive end of the planning interval (UTC).']
  department_or_zone string [note: 'Department or zone within the store.']
  role_code string [note: 'Workforce role the gap is measured for.']
  required_labor_hours string [note: 'Labor hours required in the interval, from gold_workforce_labor_requirement.']
  required_headcount string [note: 'Required headcount in the interval.']
  scheduled_hours string [note: 'Published labor_schedule hours overlapping the interval, clipped to the interval boundaries.']
  recommended_hours string [note: 'Proposed workforce_schedule_recommendation hours overlapping the interval, clipped to the interval boundaries. Status = …']
  covered_hours string [note: 'Scheduled plus recommended hours overlapping the interval.']
  shortfall_hours string [note: 'Unmet required hours (required minus covered, floored at 0). Overstaffing is not reported as a negative shortfall.']
  coverage_pct string [note: 'Covered hours over required hours, capped at 2.0; 1.0 when nothing is required.']
  shortfall_severity string [note: 'Coverage band: none (no shortfall), low (>=85% covered), medium (>=60%), high (>=35%), critical (below 35%).']
  Note: 'gold · gold'
}

Table gold_workforce_demand_forecast {
  store_sk string [note: 'Surrogate key for the store.']
  store_id string [note: 'Durable store business key.']
  business_date string [note: 'Local business date the forecast interval belongs to.']
  interval_start_ts string [note: 'Inclusive start of the planning interval (UTC).']
  interval_end_ts string [note: 'Exclusive end of the planning interval (UTC).']
  interval_minutes string [note: 'Planning interval length in minutes, taken from the current labor_standard (30 when none is configured).']
  department_or_zone string [note: 'Department or zone within the store the forecast applies to.']
  role_code string [note: 'Workforce role the forecast is produced for: cashier, sales_associate, fulfillment, inventory, supervisor.']
  demand_driver string [note: 'Workload driver the forecast is expressed in, derived from role_code (transaction_count, foot_traffic, pickup_orders …']
  forecast_driver_units string [note: 'Point forecast of driver units in the interval. A transparent seasonal-average HEURISTIC, not a calibrated model output.']
  forecast_lower_bound string [note: 'Lower uncertainty proxy: 80% of the point forecast. A fixed band, not a fitted prediction interval.']
  forecast_upper_bound string [note: 'Upper uncertainty proxy: 120% of the point forecast. A fixed band, not a fitted prediction interval.']
  forecast_method string [note: 'How the row was produced: seasonal_rolling_avg when store-level history was available, hierarchical_fallback when the …']
  model_version string [note: 'Reserved for a model-backed pipeline (forecast_method = model); NULL in the shipped heuristic (ADR 0028 §4).']
  forecast_horizon_days string [note: 'Forward horizon the forecast covers, in days (7 by default).']
  forecast_origin_ts string [note: 'When the forecast was computed (UTC) — the view evaluates at query time.']
  Note: 'gold · gold'
}

Table gold_workforce_forecast_accuracy {
  store_id string [note: 'Durable store business key.']
  business_date string [note: 'Local business date the interval belongs to.']
  interval_start_ts string [note: 'Inclusive start of the planning interval (UTC).']
  interval_end_ts string [note: 'Exclusive end of the planning interval (UTC).']
  interval_minutes string [note: 'Planning interval length in minutes.']
  department_or_zone string [note: 'Department or zone within the store.']
  role_code string [note: 'Workforce role the forecast was produced for.']
  demand_driver string [note: 'Workload driver the forecast is expressed in.']
  forecast_driver_units string [note: 'Forecast driver units for the interval.']
  actual_driver_units string [note: 'Observed driver units for the interval; NULL when no actuals source is available for the driver. STORE-TOTAL grain …']
  forecast_error string [note: 'Forecast minus actual driver units. Positive = over-forecast.']
  ape string [note: 'Absolute percentage error for the interval; NULL when actuals are absent or zero. Aggregate as a weighted ratio of …']
  forecast_method string [note: 'How the forecast row was produced.']
  model_version string [note: 'Reserved for a model-backed pipeline (forecast_method = model); NULL for heuristic rows (ADR 0028 §4).']
  optimization_run_id string [note: 'workforce_optimization_run.run_id that produced the forecast being scored.']
  Note: 'gold · gold'
}

Table gold_workforce_labor_requirement {
  store_sk string [note: 'Surrogate key for the store.']
  store_id string [note: 'Durable store business key.']
  business_date string [note: 'Local business date the requirement interval belongs to.']
  interval_start_ts string [note: 'Inclusive start of the planning interval (UTC).']
  interval_end_ts string [note: 'Exclusive end of the planning interval (UTC).']
  interval_minutes string [note: 'Planning interval length in minutes.']
  department_or_zone string [note: 'Department or zone within the store.']
  role_code string [note: 'Workforce role the requirement applies to.']
  demand_driver string [note: 'Workload driver the requirement was converted from.']
  forecast_driver_units string [note: 'Forecast driver units carried through from gold_workforce_demand_forecast.']
  labor_standard_id string [note: 'Durable key of the labor_standard row applied to this interval.']
  labor_standard_version string [note: 'Version label of the applied labor_standard, so a requirement stays reproducible after the standard changes.']
  applied_labor_standard string [note: 'Labor hours per driver unit taken from the applied standard.']
  required_labor_hours string [note: 'Labor hours required in the interval: driver units x standard, floored at the minimum-headcount coverage.']
  required_headcount string [note: 'Required headcount for the interval: required hours over interval length, floored at minimum_headcount.']
  minimum_headcount string [note: 'Minimum headcount the standard mandates regardless of forecast demand.']
  coverage_rationale string [note: 'Why the standard sets this coverage (service, safety, or statutory rationale recorded on labor_standard).']
  Note: 'gold · gold'
}

