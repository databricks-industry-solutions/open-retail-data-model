  min_facing_threshold int [note: 'The assignment min_facing_count evaluated at write, recorded so the low_stock classification stays explainable after …']
  estimated_unit_count double [note: 'Weight-derived unit estimate (total weight / calibrated per-SKU unit weight). An estimate carrying uncertainty, not a …']
