  physical_command_firings string [note: 'Firings where target_entity_type = actuator (physical device commands, not notifications or webhooks).']
  notification_firings string [note: 'Firings whose action targets a role or person (alerts, not physical actuation).']
  avg_latency_ms string [note: 'Mean milliseconds from the breaching observation to the firing. Automation-loop responsiveness, not ingest latency.']
  latency_ms_sum string [note: 'Sum of latency_ms over firings with a recorded latency. Numerator of the ratio-of-sums mean latency for rollups.']
  latency_measured_firings string [note: 'Firings with a non-NULL latency_ms. Denominator of the ratio-of-sums mean latency for rollups.']
  max_latency_ms string [note: 'Worst-case response latency observed for this rule on the day.']
  success_rate_numerator string [note: 'Successful firings (execution_status = success). Numerator of the ratio-of-sums success rate.']
  success_rate_denominator string [note: 'Completed firings (success, failure or timeout). Denominator of the ratio-of-sums success rate; pending and skipped are …']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_inventory_accuracy_daily {
  rfid_count_session_sk string [note: 'Surrogate key of the RFID count session.']
  rfid_count_session_id string [note: 'Durable key of the count session: store_id|source_session_id.']
  store_sk string [note: 'Store surrogate key.']
  store_id string [note: 'Durable store business key.']
  product_sk string [note: 'Product surrogate key.']
  product_id string [note: 'Durable product business key.']
  trading_date string [note: 'Business date of the session start.']
  session_end_local_date string [note: 'Business date when the session ended in store local time.']
  reconciliation_date string [note: 'EOD inventory snapshot date used for the comparison. Sessions ending 00:00-02:59 local reconcile to the preceding local …']
  department string [note: 'Merchandise department classification.']
  category string [note: 'Merchandise category classification.']
  subcategory string [note: 'Merchandise subcategory classification.']
  scope_type string [note: 'Count scope: full_store or partial indicates whether the session aimed to cover the entire store.']
  reconciliation_basis string [note: 'aligned_eod only for full-store sessions closing in the declared EOD window; every other row is misaligned.']
  eligible_tagged_units string [note: 'Distinct active serialized units observed for the store-product in the eligibility lookback.']
  observed_units string [note: 'Distinct serialized items observed for this product during the session.']
  book_units_eod string [note: 'End-of-day book inventory units for the product at reconciliation_date.']
  unit_variance string [note: 'Difference: observed_units - book_units_eod. Positive = over book, negative = under book.']
