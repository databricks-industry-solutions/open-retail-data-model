  pick_count_since_prior int [note: 'Pick events since the prior capture of this position by this device. NULL for platforms that cannot detect events …']
  put_count_since_prior int [note: 'Putback events since the prior capture of this position by this device. NULL for platforms that cannot detect events.']
  is_gap_detected boolean [note: 'TRUE when the platform flagged a visible gap/void at this position.']
  is_misplaced_detected boolean [note: 'On an expected-product row: TRUE when something else was detected sitting at this position (the detected product gets …']
  is_price_tag_mismatch_detected boolean [note: 'TRUE when shelf CV flagged the displayed price tag against the expected one. Bridges to the ESL layer; the …']
  zone_source string [not null, note: 'How the position zone was attributed: device_placement, operator_declared, platform_localization. Fixed sensors use …']
  attribution_confidence double [not null, note: 'Confidence in assigning the capture to the stated position zone, in [0,1]. 1.0 for fixed device placement.']
  measurement_validity string [note: 'Was the sensor telling the truth. Allowed values: valid, degraded, invalid, imputed. Occluded captures are never valid.']
  arrival_completeness string [note: 'Has the data landed. Allowed values: complete, incomplete, late_arrived, precheck.']
  confidence_score double [note: 'Detector confidence for this capture, [0,1], where supplied.']
