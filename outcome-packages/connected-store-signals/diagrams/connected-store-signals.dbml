  successful_firings string [note: 'Firings in the episode window with execution_status = success.']
  failed_firings string [note: 'Firings in the episode window with execution_status = failure.']
  first_firing_ts string [note: 'Timestamp of the first automation firing triggered by this episode. NULL if no firings occurred.']
  minutes_to_first_successful_action string [note: 'Minutes from episode start to the first successful firing triggered by an episode interval. NULL when none succeeded.']
  has_successful_action string [note: 'TRUE when at least one firing triggered by an episode interval succeeded. Evidence that the loop responded, not proof …']
  is_open_at_dataset_end string [note: 'TRUE when the episode ends at the latest interval the device reported for this property, meaning the excursion may …']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
