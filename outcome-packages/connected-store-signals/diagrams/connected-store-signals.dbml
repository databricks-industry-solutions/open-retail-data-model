  is_stray_suspect boolean [not null, note: 'TRUE when RF bleed makes location attribution suspect; excluded from presence gold.']
  antenna_id string [note: 'Winning reader antenna identifier; provenance detail, not a separate registry.']
  read_count bigint [not null, note: 'Number of raw RF pings collapsed into this visibility event.']
  duplicate_delivery_count bigint [note: 'Duplicate source deliveries suppressed for this event.']
  rssi_peak_dbm double [note: 'Peak received signal strength in dBm across collapsed pings.']
  raw_data_uri string [note: 'Pointer to raw RF-ping evidence in Bronze.']
  ingest_timestamp timestamp [not null, note: 'When the event arrived in the lakehouse (UTC); may be much later than event_ts for offline readers.']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC).']
  Note: 'transactional · silver'
}

Table sensing_deployment {
  sensing_deployment_sk bigint [pk, note: 'Surrogate key. Unique per SCD2 version.']
  sensing_deployment_id string [not null, note: 'Durable natural/business key for the deployment.']
  store_sk bigint [note: 'FK to store.store_sk.']
  store_id string [note: 'Durable store business key.']
  deployment_name string [note: 'Human-readable deployment name, e.g. "Front-of-store thermal counters, UK estate".']
  sensing_method_code string [note: 'Sensing technology -- the legal analysis differs per method. Allowed values: ir_beam, thermal, video_cv, stereo_vision …']
  sensing_purpose_code string [note: 'Declared purpose. Allowed values: people_counting, occupancy_safety, queue_management, layout_optimisation …']
  lawful_basis_code string [note: 'GDPR Art. 6 basis or equivalent. Allowed values: legitimate_interest, consent, legal_obligation, vital_interest …']
  jurisdiction_code string [note: 'ISO 3166-1 alpha-2 country, or country-subdivision for state-level regimes (e.g. US-IL for BIPA, US-TX for CUBI).']
  dpia_completed_flag boolean [note: 'TRUE if a data protection impact assessment has been completed for this deployment.']
  dpia_reference string [note: 'Pointer to the DPIA artefact (document id or URI).']
  dpia_covers_employees_flag boolean [note: 'TRUE if the DPIA explicitly assessed risks to employees, not only customers.']
  dpia_review_due_date date [note: 'When the DPIA must be reassessed. EDPB 02/2026: anonymity is not a one-time determination.']
  signage_posted_flag boolean [note: 'TRUE if on-premises notice is posted at every point of entry to the sensed area.']
  ai_act_notice_status string [note: 'AI Act Art. 50(3) deployer notice status. Allowed values: not_applicable, required_posted, required_not_posted.']
  works_council_consulted_flag boolean [note: 'TRUE if employee representatives were consulted before deployment, where the jurisdiction requires it.']
  consultation_reference string [note: 'Pointer to the consultation record (document id or URI).']
  consent_required_flag string [note: 'Whether the method requires consent. Allowed values: required, not_required, under_review. TRUE-equivalent (required) …']
  optout_mechanism_code string [note: 'How a data subject objects. Allowed values: none, signage_contact, in_store_kiosk, web_portal, not_applicable.']
  retention_days_max int [note: 'Maximum retention for personal data from this deployment, in days. A ceiling, not an entitlement.']
  retention_basis string [note: 'Why this retention -- the statutory or policy source.']
  staff_exclusion_method string [note: 'How staff are excluded. Allowed values: none, exclusion_line, zone_button, patterned_tag, fabric_tag, uniform_ml …']
  staff_exclusion_stage string [note: 'WHERE exclusion is applied -- without this you cannot tell whether a received number was already corrected, so …']
  external_disclosure_policy_sk bigint [note: 'FK lineage to the policy version current when this deployment version was written; shared views resolve controls …']
  external_disclosure_policy_id string [note: 'Durable disclosure-policy id for SCD2-safe resolution.']
  deployment_status string [note: 'Allowed values: planned, active, suspended, decommissioned.']
  deployed_date date [note: 'When sensing began at this deployment.']
  decommissioned_date date [note: 'When sensing ceased. NULL while active.']
  effective_from_date date [not null, note: 'SCD2: inclusive start date this version became effective.']
  effective_to_date date [note: 'SCD2: exclusive end date; NULL for the current version.']
  is_current boolean [not null, note: 'SCD2: TRUE for the currently active version.']
  created_timestamp timestamp [note: 'When the record was created in the source system (UTC, ISO 8601).']
  source_updated_timestamp timestamp [note: 'When the record was last modified in the source system (UTC, ISO 8601).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
  Note: 'master · silver'
}

Table sensing_disclosure_policy {
  sensing_disclosure_policy_sk bigint [pk, note: 'Surrogate key for this effective-dated policy version.']
  sensing_disclosure_policy_id string [not null, note: 'Durable policy business key.']
  audience_code string [not null, note: 'Intended disclosure audience, such as external or partner.']
  k_threshold int [not null, note: 'Minimum count published to this audience. Zero disables below-k suppression so suppress_zero_flag can govern measured …']
  suppress_zero_flag boolean [not null, note: 'TRUE when measured zero cells are suppressed for this audience.']
  minimum_interval_minutes int [not null, note: 'Minimum publishable time window. Finer canonical rows must be aggregated before threshold evaluation.']
  effective_from_date date [not null, note: 'Inclusive policy-effective date.']
  effective_to_date date [note: 'Exclusive policy-effective date; NULL for current.']
  is_current boolean [not null, note: 'TRUE for the current policy version.']
  policy_basis string [note: 'Governance or policy basis for the configured disclosure controls.']
  record_source string [note: 'Originating system of record.']
  load_timestamp timestamp [note: 'When this policy version was loaded (UTC).']
  Note: 'master · silver'
}

Table sensor_device {
  sensor_device_sk bigint [pk, note: 'Surrogate key. Unique per SCD2 version.']
  sensor_device_id string [not null, note: 'Durable natural/business key for the device. Stable across SCD2 versions and across firmware upgrades.']
  store_sk bigint [note: 'FK to store.store_sk.']
  store_id string [note: 'Durable store business key.']
  store_zone_sk bigint [note: 'FK to store_zone.store_zone_sk -- where the device is installed.']
  store_zone_id string [note: 'Durable zone id. The SCD2-safe join key.']
  device_type string [note: 'What the device is. Allowed values: people_counter, occupancy_sensor, temperature, humidity, co2, illuminance …']
  sensing_technology string [note: 'How it senses -- drives the accuracy and privacy profile. Allowed values: ir_beam, thermal, video_cv, stereo_vision …']
  device_role string [note: 'Allowed values: sense, actuate, both. ESL gateways actuate; counters sense.']
  manufacturer string [note: 'Device manufacturer.']
  model string [note: 'Device model designation.']
  serial_number string [note: 'Manufacturer serial number.']
  firmware_version string [note: 'Current firmware version. Changes here are a common cause of a step change in counting behaviour, so it is versioned …']
  is_directional boolean [note: 'TRUE if the device distinguishes entry from exit. FALSE means exit_count must be NULL, never 0.']
  supports_dwell boolean [note: 'TRUE if the device measures dwell time.']
  supports_occupancy boolean [note: 'TRUE if the device reports occupancy directly rather than by entry/exit balance.']
  is_mobile_platform boolean [note: 'TRUE for a reader mounted on a moving handheld or robotic platform. Mobile readers resolve event zones from operator …']
  detection_limit_count int [note: 'Hardware detection ceiling, where the vendor publishes one. A peak at this value is capped, not exact.']
  battery_powered boolean [note: 'TRUE if battery powered -- a capability, not a level. The battery LEVEL is a fast-moving measure and belongs on …']
  brick_class_iri string [note: 'Brick Schema 1.4.4 class IRI, e.g. https://brickschema.org/schema/Brick#Occupancy_Count_Sensor.']
  unit_iri string [note: 'QUDT unit IRI for the device native unit, e.g. http://qudt.org/vocab/unit/DEG_C. The internal canonical unit reference.']
  uom_code string [note: 'UN/CEFACT Recommendation 20 common code for the native unit, e.g. CEL, KWH, WTT, H87, P1. The interchange form.']
  bacnet_device_id string [note: 'BACnet device instance, for building-automation-sourced devices (ANSI/ASHRAE 135-2024).']
  bacnet_object_ref string [note: 'BACnet object reference, e.g. the Access Zone object (Clause 12.32) backing an occupancy count.']
  bacnet_out_of_service boolean [note: 'BACnet Out_Of_Service. When TRUE the Present_Value is SIMULATED -- without carrying this you silently ingest fabricated …']
  opc_ua_node_id string [note: 'OPC UA NodeId, for industrial/refrigeration controllers.']
  sparkplug_edge_node_id string [note: 'Sparkplug B (ISO/IEC 20237:2023) edge node id. Session identity is (edge_node_id, bdSeq).']
  calibration_certificate_id string [note: 'NIST-traceable Certificate of Calibration Testing identifier.']
  calibration_valid_from date [note: 'Start of the current calibration validity window.']
  calibration_valid_to date [note: 'End of the current calibration validity window. Past-due active devices are flagged by sd_calibration_current.']
  accuracy_tolerance double [note: 'Rated accuracy in the device native unit, e.g. 0.5 for +/-0.5 degC. CDC/VFC requires +/-0.5 degC for vaccine storage.']
  probe_type string [note: 'Allowed values: buffered, air, glycol, surface, none. CDC/VFC requires a BUFFERED probe for vaccine storage; an air …']
  is_backup_device boolean [note: 'TRUE if this is the staggered-calibration backup unit required for vaccine storage.']
  sensing_deployment_sk bigint [note: 'FK to sensing_deployment.sensing_deployment_sk -- the governance record for this installation.']
  sensing_deployment_id string [note: 'Durable deployment id. The SCD2-safe join key.']
  equipment_sk bigint [note: 'FK to equipment.equipment_sk when the device monitors a maintained asset. NULL for ambient/space sensing.']
  equipment_id string [note: 'Durable equipment business key. NULL for ambient/space sensing.']
  device_status string [note: 'Allowed values: active, inactive, faulty, maintenance, decommissioned.']
  installed_date date [note: 'When the device was installed.']
  decommissioned_date date [note: 'When the device was removed. NULL while in service.']
  effective_from_date date [not null, note: 'SCD2: inclusive start date this version became effective.']
  effective_to_date date [note: 'SCD2: exclusive end date; NULL for the current version.']
  is_current boolean [not null, note: 'SCD2: TRUE for the currently active version.']
  created_timestamp timestamp [note: 'When the record was created in the source system (UTC, ISO 8601).']
  source_updated_timestamp timestamp [note: 'When the record was last modified in the source system (UTC, ISO 8601).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
  Note: 'master · silver'
}

Table sensor_report_interval {
  sensor_report_interval_sk bigint [pk, not null, note: 'Surrogate key: xxhash64(sensor_report_interval_id). NOT an identity column -- see ADR 0028, Hash surrogate keys for …']
  sensor_report_interval_id string [not null, note: 'Durable grain key …']
  subject_type string [not null, note: 'What kind of thing was measured. Allowed values: epc, gln, grai, point, space. Foot traffic is space.']
  subject_id string [not null, note: 'Identifier of the measured subject, interpreted per subject_type.']
  store_sk bigint [note: 'FK to store.store_sk.']
  store_id string [note: 'Durable store business key.']
  store_zone_sk bigint [note: 'FK to store_zone.store_zone_sk.']
  store_zone_id string [note: 'Durable zone id. The SCD2-safe join key (ADR 0025).']
  product_sk bigint [note: 'FK to product.product_sk. NULL for space subjects; populated for item- or shelf-scoped reports.']
  product_id string [note: 'Durable product business key. NULL for space subjects.']
  equipment_sk bigint [note: 'FK to equipment.equipment_sk when the reported subject is a maintained asset (a refrigeration case, an HVAC unit). NULL …']
  equipment_id string [note: 'Durable equipment business key. NULL for space subjects and ambient sensing.']
  report_type string [not null, note: 'GS1 CBV sensor-property CURIE. Allowed values: gs1:Count, gs1:Temperature, gs1:RelativeHumidity, gs1:Power, gs1:Energy …']
  value double [note: 'The reported value for report_type over the interval.']
  min_value double [note: 'EPCIS minValue over the interval.']
  max_value double [note: 'EPCIS maxValue over the interval.']
  mean_value double [note: 'EPCIS meanValue over the interval.']
  s_dev double [note: 'EPCIS sDev. Valid only alongside mean_value (sri_epcis_field_pairing).']
  perc_rank double [note: 'EPCIS percRank -- the percentile requested.']
  perc_value double [note: 'EPCIS percValue -- the value at perc_rank. Valid only alongside perc_rank.']
  string_value string [note: 'EPCIS stringValue, for non-numeric reports.']
  boolean_value boolean [note: 'EPCIS booleanValue, for binary reports such as door open/closed.']
  uom string [note: 'UN/CEFACT Recommendation 20 common code, e.g. CEL, KWH, WTT, H87, P1. The interchange form.']
  unit_iri string [note: 'QUDT unit IRI. The internal canonical unit reference -- UN/CEFACT codes are ambiguous across contexts, QUDT is not.']
  aggregation_level string [not null, note: 'The level this row is measured AT -- never sum across values of this column. Allowed values: site, entrance, area …']
  source_observation_count bigint [note: 'Number of source observations received for this interval. Derived from source cadence and delivery completeness, never …']
  expected_observation_count bigint [note: 'Number of source observations expected under the effective source cadence for this interval.']
  interval_start_ts timestamp [not null, note: 'Interval start as a UTC instant. The ONLY safe ordering and join key.']
  interval_end_ts timestamp [note: 'Interval end as a UTC instant (EPCIS endTime).']
  interval_minutes int [not null, note: 'Canonical interval length in minutes and part of the grain key. A series has one non-overlapping cadence; alternate …']
  store_timezone string [note: 'IANA timezone name, e.g. America/New_York. Not an offset -- the zone, so DST history is derivable.']
  utc_offset_minutes smallint [not null, note: 'Offset from UTC in minutes at interval_start_ts, e.g. -240 vs -300. THE DST FIX: it makes the autumn fold unambiguous …']
  trading_date date [not null, note: 'Business date of the interval. Joins to fiscal_calendar.date_key as a LOGICAL join, not an FK -- see relationships.sql.']
  trading_day_offset smallint [note: '-1 / 0 / +1. Non-zero for stores trading past midnight, where the calendar date and the trading date diverge.']
  hour_of_day int [note: 'Local hour 0-23, derived from interval_start_ts + utc_offset_minutes.']
  day_part string [note: 'Allowed values: pre_open, morning, midday, afternoon, evening, late.']
  is_partial_interval boolean [note: 'TRUE if the interval is not yet closed, or was truncated by opening/closing hours.']
  is_dst_transition boolean [note: 'Convenience flag for the DST fold/gap. No longer load-bearing now that utc_offset_minutes is present.']
  time_mode string [note: 'Allowed values: within_operating_hours, all_day. Vendors expose this per metric rather than per feed, so it belongs on …']
  measurement_validity string [note: 'Was the sensor telling the truth. Allowed values: valid, degraded, invalid, imputed.']
  arrival_completeness string [note: 'Has the data landed. Allowed values: complete, incomplete, late_arrived, precheck.']
  is_imputed boolean [note: 'TRUE if the value was modelled rather than measured. Only one surveyed vendor documents that it imputes at all; model …']
  uptime_ratio double [note: 'Fraction of the interval the device was online, [0,1].']
  coverage_ratio double [note: 'Fraction of the subject expected sensors that reported, [0,1].']
  confidence_score double [note: 'Vendor or model confidence, [0,1], where supplied.']
  sensor_online_flag boolean [note: 'TRUE if the device was online for the interval.']
  is_capped boolean [note: 'TRUE if the value hit the device detection ceiling. A capped peak is NOT an exact peak.']
  capped_count_limit int [note: 'The ceiling that was hit, when is_capped is TRUE.']
  ingest_timestamp timestamp [note: 'When the row was ingested (UTC). With interval_start_ts this gives arrival latency.']
  latency_seconds int [note: 'Seconds between interval end and ingest. Feeds gold_css_device_health.']
  restatement_version int [note: 'Monotonic per grain key. These feeds are NOT append-only: vendors publish a late-data status that later resolves, and …']
  restated_at_timestamp timestamp [note: 'When this version of the row was written (UTC). NULL for the first version.']
  sensor_device_sk bigint [note: 'FK to sensor_device.sensor_device_sk. NULL for a cross-device aggregate.']
  sensor_device_id string [note: 'Durable device id, and part of the grain key. A cross-device aggregate uses the explicit sentinel _ALL, NEVER NULL -- a …']
  sensing_deployment_sk bigint [note: 'FK to sensing_deployment.sensing_deployment_sk -- the governance record that applied at measurement time (ADR 0031).']
  sensing_deployment_id string [note: 'Durable deployment id. The SCD2-safe join key.']
  device_metadata_uri string [note: 'EPCIS deviceMetadata -- calibration and accuracy context for this reading.']
  raw_data_uri string [note: 'EPCIS rawData -- pointer to the sub-interval pulses in bronze, outside ORDM. EPCIS itself states it SHOULD NOT carry …']
  data_processing_method_uri string [note: 'EPCIS dataProcessingMethod -- how raw observations became this aggregate.']
  biz_rules_uri string [note: 'EPCIS bizRules -- the threshold or rule that was applied, e.g. the excursion rule version.']
  source_session_id string [note: 'Source session identifier effective for the interval, when one session covers the interval.']
  source_message_count bigint [note: 'Number of source messages delivered for the interval.']
  sequence_gap_count bigint [note: 'Number of source messages inferred missing from sequence gaps.']
  duplicate_delivery_count bigint [note: 'Number of duplicate source-message deliveries in the interval.']
  historical_message_count bigint [note: 'Number of delivered source messages marked as buffered or historical.']
  bad_quality_message_count bigint [note: 'Number of delivered source messages carrying bad or stale source quality.']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
  Note: 'transactional · silver'
}

Table shelf_position_assignment {
  shelf_position_assignment_sk bigint [pk, note: 'Surrogate key. Unique per SCD2 version.']
  shelf_position_assignment_id string [not null, note: 'Durable natural key: store_zone_id|product_id. One current version per shelf-position zone and product.']
  store_sk bigint [not null, note: 'FK to the store version in effect when this version was written.']
  store_id string [not null, note: 'Durable store business key.']
  store_zone_sk bigint [not null, note: 'FK to the shelf-position zone version (store_zone.zone_type = shelf_position).']
  store_zone_id string [not null, note: 'Durable shelf-position zone id. The zone carries the aisle/bay ancestry via hierarchy_path.']
  product_sk bigint [not null, note: 'FK to the product version in effect when this version was written.']
  product_id string [not null, note: 'Durable product business key expected at this position.']
  expected_facing_count int [note: 'Facings this product should present at this position per the expected state.']
  min_facing_count int [note: 'Low-stock threshold: observed facings below this and above zero classify as low_stock at evaluation time.']
  facing_sequence int [note: 'Optional left-to-right sequence of this product within its bay, where the source system provides it.']
  assignment_source string [note: 'Provenance of the expected state. Allowed values: planogram, manual, vendor. Adopters without slot-level planograms …']
  planogram_id string [note: 'Logical reference to the BMV planogram business key this assignment was derived from, when assignment_source = …']
  assignment_status string [note: 'Allowed values: active, suspended, retired.']
  valid_from_ts timestamp [not null, note: 'Inclusive UTC instant this version became the expected state. The version grain key.']
  valid_to_ts timestamp [note: 'Exclusive UTC instant this version stopped applying; NULL for the current version.']
  effective_from_date date [not null, note: 'SCD2: inclusive start date this version became effective. Derived: CAST(valid_from_ts AS DATE).']
  effective_to_date date [note: 'SCD2: exclusive end date; NULL for the current version. Derived from valid_to_ts.']
  is_current boolean [not null, note: 'SCD2: TRUE for the currently active version.']
  created_timestamp timestamp [note: 'When the record was created in the source system (UTC, ISO 8601).']
  source_updated_timestamp timestamp [note: 'When the record was last modified in the source system (UTC, ISO 8601).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
  Note: 'association · silver'
}

Table shelf_state_observation {
