  inventory_accuracy_pct string [note: 'Observed-versus-EOD-book agreement for aligned_eod rows only; NULL for misaligned sessions.']
  observed_to_book_agreement_pct string [note: 'Agreement evidence for misaligned sessions; it must not be labeled inventory accuracy.']
  is_phantom_stock string [note: 'TRUE when an aligned eligible product has positive EOD book stock and zero observed units.']
  is_record_inaccuracy string [note: 'TRUE when observed_units <> book_units_eod (record discrepancy).']
  reconciled_at_ts string [note: 'Timestamp when the record was reconciled.']
  Note: 'gold · gold'
}

Table gold_inventory_accuracy_daily_latest {
  store_sk string [note: 'Store surrogate key.']
