Table gold_store_traffic_daily_current {
  store_id string [note: 'Durable store business key.']
  trading_date string [note: 'Business date, derived from the UTC instant plus the store UTC offset -- not a calendar date in the reader timezone.']
  fiscal_year string [note: 'NRF fiscal year for the trading date.']
  fiscal_period string [note: 'NRF fiscal period for the trading date.']
  fiscal_week string [note: 'NRF fiscal week number (1-53 or 1-52) within the fiscal year.']
  fiscal_week_id string [note: 'NRF fiscal week identifier, embedded with fiscal year for cross-year grouping.']
  fiscal_week_index string [note: 'Monotonic index for fiscal weeks, used to order fiscal weeks across calendar years.']
  day_of_week string [note: 'ISO day of week for the trading date (1 = Monday, 7 = Sunday).']
  is_holiday string [note: 'TRUE when the trading date is a recognised retail holiday.']
  footfall_count string [note: 'Store footfall for the day, measured AT site level. NOT a sum over zones -- a shopper traversing five zones would be …']
  entry_count string [note: 'Measured entries. The denominator for per-entry productivity measures.']
  exit_count string [note: 'Measured exits. NULL where the sensors are non-directional and therefore cannot measure them. Entries and exits are …']
  visitor_count_adjusted string [note: 'Footfall after staff exclusion. Equals visitor_count_raw - staff_count.']
  staff_count string [note: 'Staff detections excluded from footfall.']
  child_count string [note: 'Child detections. A SUBSET of footfall, not an exclusion from it.']
  peak_occupancy string [note: 'Highest simultaneous occupancy in the day. Semi-additive: a MAX over intervals, never a SUM.']
  avg_occupancy string [note: 'Mean simultaneous occupancy, DURATION-WEIGHTED by interval length rather than an average of averages.']
  dwell_seconds_total string [note: 'Dwell numerator. Kept alongside dwell_count so the average re-aggregates correctly at any grain.']
  dwell_count string [note: 'Dwell denominator -- the number of dwell observations.']
  avg_dwell_seconds string [note: 'dwell_seconds_total / dwell_count.']
  footfall_count_py string [note: 'Footfall on the equivalent NRF fiscal week and weekday last year, not the same calendar date.']
  footfall_delta_py string [note: 'Absolute difference: footfall_count - footfall_count_py. Prior-year change in count.']
  footfall_growth_py string [note: 'Fractional growth against footfall_count_py.']
  counting_unit string [note: 'What one count represents: person, group, device or object. A footfall number is uninterpretable without it.']
  staff_exclusion_enabled string [note: 'TRUE if staff were excluded. Store-days differing on this are not comparable without saying so.']
  group_counting_enabled string [note: 'TRUE if family or shopping groups were counted as one. Changes counting_unit from person to group.']
  time_mode string [note: 'Whether the day covers operating hours only or all day. Vendors expose this per metric, so it travels with the row.']
  avg_uptime_ratio string [note: 'Mean share of canonical interval duration the sensors were online. Read this before trusting a low count.']
  avg_coverage_ratio string [note: 'Mean share of expected sensors that reported. A low value means the count is PARTIAL, not low.']
  valid_interval_share string [note: 'Share of intervals whose measurement was valid. Orthogonal to completeness -- an interval can be complete but invalid.']
  complete_interval_share string [note: 'Share of intervals whose data had fully landed. Orthogonal to validity.']
  has_imputed_intervals string [note: 'TRUE if any interval was modelled rather than measured.']
  is_zero_observed string [note: 'TRUE when footfall_count = 0 AND any interval within the day carried is_zero_observed = TRUE. Distinguishes a measured …']
  interval_count string [note: 'Source intervals behind the row.']
  interval_minutes_total string [note: 'Total duration of valid traffic intervals. This generic duration is not the denominator for measures that were reported …']
  occupancy_interval_minutes_total string [note: 'Duration of valid intervals with a reported occupancy average; the re-aggregation denominator for avg_occupancy.']
  uptime_interval_minutes_total string [note: 'Duration of intervals with a reported uptime ratio; the re-aggregation denominator for avg_uptime_ratio.']
  coverage_interval_minutes_total string [note: 'Duration of intervals with a reported coverage ratio; the re-aggregation denominator for avg_coverage_ratio.']
  aggregation_level string [note: 'Always site for this view. Present so a consumer joining it to zone data cannot mix levels by accident.']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

