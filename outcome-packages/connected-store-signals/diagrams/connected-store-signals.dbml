  restated_at_timestamp timestamp [note: 'When this version of the row was written (UTC). NULL for the first version.']
  raw_data_uri string [note: 'Pointer to raw capture evidence (image crops, weight event stream) in Bronze, outside ORDM.']
  ingest_timestamp timestamp [note: 'When the observation arrived in the lakehouse (UTC).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC).']
  Note: 'transactional · silver'
}

Table store_zone {
  store_zone_sk bigint [pk, note: 'Surrogate key. Unique per SCD2 version.']
  store_zone_id string [not null, note: 'Durable natural/business key for the zone. Stable across SCD2 versions.']
  store_sk bigint [note: 'FK to store.store_sk (SCD2 version current at load).']
  store_id string [note: 'Durable store business key. Use this for SCD2-safe joins (ADR 0025).']
  zone_code string [note: 'Zone code as emitted by the source system. Replaces the bare store_zone_code string the CMN fact carried.']
  zone_name string [note: 'Human-readable zone name for display and Genie.']
  zone_type string [note: 'Depth in the spatial hierarchy. Allowed values: site, entrance, area, department, aisle, bay, shelf_position, queue …']
  parent_zone_sk bigint [note: 'FK to store_zone.store_zone_sk -- the containing zone. NULL for the site row.']
  parent_zone_id string [note: 'Durable id of the containing zone. The SCD2-safe join key; prefer this over parent_zone_sk.']
  hierarchy_depth int [note: 'Materialised depth (0 = site). Avoids a recursive CTE in every consumer.']
  hierarchy_path string [note: 'Materialised ancestry path, e.g. /site/area-grocery/aisle-07. Denormalised for filtering.']
  area_sqm decimal(12,2) [note: 'Zone floor area in square metres. Denominator for traffic and occupancy density.']
  capacity_persons int [note: 'Safe/design occupancy in persons, where known. Used to warn on implausible occupancy, never to clamp it.']
  is_sales_floor boolean [note: 'TRUE if the zone is customer-accessible selling space. FALSE for back-of-house.']
  is_countable boolean [note: 'TRUE if this zone is instrumented for people counting. FALSE zones exist for spatial structure only.']
  effective_from_date date [not null, note: 'SCD2: inclusive start date this version became effective.']
  effective_to_date date [note: 'SCD2: exclusive end date; NULL for the current version.']
  is_current boolean [not null, note: 'SCD2: TRUE for the currently active version.']
  created_timestamp timestamp [note: 'When the record was created in the source system (UTC, ISO 8601).']
  source_updated_timestamp timestamp [note: 'When the record was last modified in the source system (UTC, ISO 8601).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
  Note: 'master · silver'
}

Table tagged_item {
  tagged_item_sk bigint [pk, not null, note: 'Surrogate join key: xxhash64(tagged_item_id). The durable id remains authoritative; guarded by ti_sk_collision.']
  tagged_item_id string [not null, note: 'Durable serialized-item key, valued as a GS1 EPC Pure Identity URI such as urn:epc:id:sgtin:0614141.107346.2017.']
  epc_scheme string [not null, note: 'EPC identity scheme. Allowed values: sgtin, grai.']
  gtin string [note: 'GTIN decomposed from an SGTIN EPC. NULL for schemes without a GTIN component.']
  serial_number string [note: 'Serialized-unit component of an SGTIN EPC. Required for epc_scheme = sgtin.']
  current_tid_hex string [note: 'Current physical RFID tag-chip identifier in hexadecimal. Carrier evidence, not serialized-item identity.']
  product_sk bigint [note: 'FK to the product version resolved when the item was commissioned. NULL when the EPC cannot be resolved to a product.']
  product_id string [note: 'Durable product business key. Retained with product_sk for portable joins.']
  lot_number string [note: 'Optional source lot identifier for fresh or regulated categories; not a conformed lot entity.']
  expiry_date date [note: 'Optional item expiry date for fresh or regulated categories.']
  tag_privacy_state string [not null, note: 'Current tag privacy state. Allowed values: active, protected, killed, detached.']
  commissioned_at_ts timestamp [not null, note: 'UTC instant when this EPC was commissioned for the serialized item.']
  decommissioned_at_ts timestamp [note: 'UTC instant when this EPC left active service. NULL while active.']
  created_timestamp timestamp [note: 'When the registry record was created in the source system (UTC).']
  source_updated_timestamp timestamp [note: 'When the Type 1 registry row was last changed in the source system (UTC).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC).']
  Note: 'master · silver'
}

Table gold_count_session_summary {
  rfid_count_session_sk string [note: 'Surrogate key for the bounded RFID count session.']
  rfid_count_session_id string [note: 'Durable key: store_id|source_session_id.']
  source_session_id string [note: 'Source session identifier. For fixed windows without one: count_method|primary_sensor_device_id or …']
  store_sk string [note: 'Store surrogate key.']
  store_id string [note: 'Durable store business key.']
  primary_sensor_device_sk string [note: 'Surrogate key of the initiating or primary sensor device. The complete device set derives from events.']
  primary_sensor_device_id string [note: 'Durable id of the initiating or primary device.']
  count_method string [note: 'RFID count method. Allowed values: handheld_sweep, fixed_window, robot_sweep.']
  scope_type string [note: 'Representable scope claim. full_store has a derivable zone plan; partial makes no plan claim.']
  started_at_ts string [note: 'Session start as a UTC instant.']
  ended_at_ts string [note: 'Session end as a UTC instant.']
  trading_date string [note: 'Business date of the session start.']
  duration_minutes string [note: 'Session duration in minutes from started_at_ts to ended_at_ts.']
  planned_zones string [note: 'Active non-site zones derived at session start for full_store sessions; NULL for partial scope.']
  zones_covered string [note: 'Zones where read events were observed. For full_store scope, intersection of observed zones with planned zones; for …']
  zones_missed string [note: 'Planned zones with no observed read events. NULL for partial_scope sessions.']
  zone_coverage_rate string [note: 'Observed zones divided by derived planned zones for full_store sessions only.']
  units_observed string [note: 'Count of distinct serialized items (tagged_item_id) observed during the session, excluding stray reads.']
  devices_observed string [note: 'Count of distinct sensor devices that reported read events in the session.']
  first_event_ts string [note: 'Timestamp of the first non-stray read event in the session.']
  last_event_ts string [note: 'Timestamp of the last non-stray read event in the session.']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_css_automation_response {
  store_id string [note: 'Durable store business key of the device that fired the loop.']
  store_zone_id string [note: 'Durable id of the zone the observing device is installed in.']
  sensor_device_id string [note: 'Durable id of the observing device whose reading breached the rule, resolved from the triggering interval …']
  device_type string [note: 'Kind of device that triggered the firing, e.g. temperature for the cold-chain excursion loop.']
  device_status string [note: 'Status of the observing device at firing time: active, inactive, failed.']
  execution_log_id string [note: 'Durable id of the firing. Identifies the action-that-ran-against-its-triggering-observation, not merely the observation …']
  triggered_at_timestamp string [note: 'When the action fired (UTC). The ledger ordering key.']
  trading_date string [note: 'Business date of the breach that fired the loop, from the triggering interval; the firing date is the fallback when the …']
  execution_status string [note: 'Outcome of the firing: success, failure, pending, timeout or skipped.']
  latency_ms string [note: 'Milliseconds from the breaching observation to the firing. Automation RESPONSE latency, NOT ingest latency -- do not …']
  response_latency_band string [note: 'fast (<= 250 ms), normal (<= 1000 ms), slow (> 1000 ms), or unknown. A responsiveness band, not a data-quality one.']
  response_payload string [note: 'The actual payload delivered when the action fired (JSON or string representation).']
  automation_action_id string [note: 'Durable id of the automation action that fired.']
  action_type string [note: 'What kind of action fired: system_command, notification, webhook, ticket or log_only. One breach can fan out to several …']
  target_entity_type string [note: 'The kind of thing the action targeted -- actuator, role, person or external_system. Only the actuator target carries a …']
  target_entity_id string [note: 'Durable id of the target, interpreted per target_entity_type.']
  action_is_enabled string [note: 'TRUE if the action version that fired was live. A disabled action leaves its rule firing but takes no effect.']
  payload_template string [note: 'Template used to generate response_payload.']
  evaluation_rule_id string [note: 'Durable id of the rule whose breach fired the action.']
  rule_name string [note: 'Human-readable rule name, e.g. an over-temperature excursion on a named device.']
  report_type string [note: 'GS1 CBV property the rule watches, e.g. gs1:Temperature. Shared vocabulary with sensor_report_interval.report_type.']
  condition_operator string [note: 'The comparison applied by the rule (e.g. greater_than, less_than, inside_range).']
  severity string [note: 'Operational severity of the breach: info, warning or critical.']
  threshold_value_numeric string [note: 'The threshold the observed value was compared against, in the rule unit, AS OF the firing. DOUBLE, matching …']
  threshold_value_upper string [note: 'Upper bound for inside_range or outside_range operators, in the rule unit.']
  time_window_seconds string [note: 'Rule time_window_seconds: the sustained-breach window that must hold before the rule fires.']
  rule_uom_code string [note: 'UN/CEFACT unit code for the rule threshold (e.g. CEL for Celsius, NUM for count).']
  actuator_capability_id string [note: 'Durable id of the actuator the command hit. NULL for non-actuator actions or a retired actuator.']
  command_type string [note: 'What the actuator was commanded to do, e.g. toggle_power. NULL for a non-actuator action such as a notification.']
  actuator_status string [note: 'Status of the actuator at firing time: active, inactive, failed, or unknown.']
  equipment_id string [note: 'Durable business key of the asset the actuator drives, e.g. the refrigeration unit. NULL for ambient or digital-only …']
  sensor_report_interval_sk string [note: 'The reading interval that breached the rule, closing the loop back to the observation. NULL if the trigger was not a …']
  sensor_report_interval_id string [note: 'Durable id of the interval that triggered the firing (survives across SCD2 versions).']
  breach_value string [note: 'The observed value that breached the rule, in breach_uom. For the cold-chain loop this is the temperature that exceeded …']
  breach_uom string [note: 'UN/CEFACT unit code for the breach_value (e.g. CEL for Celsius, NUM for count).']
  interval_end_ts string [note: 'End timestamp of the triggering canonical interval.']
  breach_margin string [note: 'Signed difference of breach_value from threshold_value_numeric, in the rule unit. Positive means above threshold -- how …']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_css_device_health {
  store_id string [note: 'Durable store business key.']
  device_type string [note: 'The dimension that lets ONE view serve the whole estate. IoT, RFID and Smart Shelf add rows here, not new views.']
  trading_date string [note: 'Business date of the device health observation.']
  report_type string [note: 'Measurement type (e.g. gs1:Count for traffic sensors, gs1:Temperature for environmental monitoring).']
  aggregation_level string [note: 'Reporting granularity level.']
  sensor_device_id string [note: 'Durable device business key.']
  sensor_device_sk string [note: 'Device surrogate key.']
  sensing_technology string [note: 'How the device senses. Drives both the accuracy and the privacy profile.']
  device_status string [note: 'Current status of the device: active, inactive, retired, or maintenance.']
  store_zone_id string [note: 'Durable zone where the device is installed.']
  manufacturer string [note: 'Device manufacturer name.']
  model string [note: 'Device model identifier.']
  firmware_version string [note: 'Current firmware. A common cause of a STEP CHANGE in counting behaviour, so group by it when investigating a …']
  battery_powered string [note: 'TRUE if the device is battery-powered; FALSE if mains-powered or wired.']
  intervals_reported string [note: 'Count of canonical intervals this device reported data in.']
  observations_expected string [note: 'Expected observation count based on device expected reporting frequency for the day.']
  observations_received string [note: 'Actual count of observations delivered.']
  missing_observation_rate string [note: '1 - (observations_received / observations_expected). The primary fleet KPI. Re-aggregate it by summing the two …']
  avg_uptime_ratio string [note: 'Mean share of canonical interval duration the device was online.']
  avg_coverage_ratio string [note: 'Mean share of expected sensors in the deployment group that reported alongside this device.']
  valid_intervals string [note: 'Count of intervals whose measurement was valid. Retained with invalid_intervals so valid-interval share can be …']
  valid_interval_share string [note: 'Share of reported intervals marked as measurement_validity = valid.']
  invalid_intervals string [note: 'Count of intervals marked measurement_validity = invalid.']
  imputed_intervals string [note: 'Count of intervals marked is_imputed = TRUE (modelled rather than measured).']
  observed_zero_intervals string [note: 'Intervals with a MEASURED zero, as distinct from an absent row. Most vendors emit no row for either a zero-traffic …']
  capped_intervals string [note: 'Intervals that hit the hardware detection ceiling. A capped peak is NOT an exact peak.']
  late_arrived_intervals string [note: 'Intervals that landed after their window closed. These feeds are NOT append-only; vendors document data arriving hours …']
  historical_message_count string [note: 'Delivered source messages marked as buffered or historical.']
  bad_quality_message_count string [note: 'Delivered source messages marked bad or stale by the source.']
  max_restatement_version string [note: 'Highest restatement_version encountered in the device data for the day.']
  last_interval_end_ts string [note: 'End timestamp of the most recent interval.']
  last_ingest_ts string [note: 'Ingest timestamp of the most recent data arrival.']
  avg_latency_seconds string [note: 'Mean latency from event timestamp to ingest timestamp.']
  max_latency_seconds string [note: 'Maximum latency for any event.']
  feed_age_minutes string [note: 'Minutes since this device last landed data.']
  feed_freshness_status string [note: 'fresh (<= 60 min), delayed (<= 6 hr), stale (> 6 hr).']
  session_count string [note: 'Distinct source_session_id values in the device-day.']
  had_session_restart string [note: 'TRUE when more than one source session appears in the device-day.']
  source_message_count string [note: 'Total count of source messages delivered for the device on the trading_date.']
  sequence_gap_count string [note: 'Source messages inferred missing within source sessions, summed from interval-level summaries.']
  duplicate_delivery_count string [note: 'Duplicate source-message deliveries, summed independently from sequence gaps.']
  calibration_valid_to string [note: 'Calibration expiration date for the device.']
  calibration_certificate_id string [note: 'Identifier of the calibration certificate.']
  accuracy_tolerance string [note: 'Rated accuracy in the device native unit. CDC/VFC requires +/-0.5 degC for vaccine storage.']
  probe_type string [note: 'buffered, air, glycol, surface or none. Vaccine storage requires BUFFERED; an air probe reacts to door openings and …']
  is_backup_device string [note: 'TRUE for the staggered-calibration backup unit required for vaccine storage.']
  calibration_status string [note: 'current, expiring_soon (<= 30 days), expired, or unknown. For vaccine storage an expiry is a compliance failure, not a …']
  bacnet_out_of_service string [note: 'BACnet Out_Of_Service. When TRUE the Present_Value is SIMULATED, so every reading from this device is fabricated.']
  sensing_deployment_id string [note: 'Durable id of the deployment this device belongs to.']
  sensing_method_code string [note: 'Method code for the sensing technology (e.g. RFID, infrared, thermal).']
  deployment_status string [note: 'Status of the deployment: active, pilot, retired.']
  dpia_completed_flag string [note: 'Whether the governing deployment has a completed impact assessment. Surfaced beside fleet health because the two are …']
  ai_act_notice_status string [note: 'AI Act Art. 50(3) deployer notice status. Applies from 2026-08-02 and was not postponed by the Digital Omnibus.']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_css_environmental_compliance_daily {
  store_id string [note: 'Durable store business key.']
  sensor_device_id string [note: 'Durable device business key of the environmental/temperature sensor.']
  subject_type string [note: 'Kind of measured subject within the device (for example point for a refrigerated case). Part of the grain.']
  subject_id string [note: 'Measured subject within the device, interpreted per subject_type (for example one case on a multi-channel logger). Part …']
  equipment_id string [note: 'Durable equipment business key (refrigeration unit) that the sensor monitors. NULL for ambient sensors.']
  report_type string [note: 'The environmental property measured (e.g. gs1:Temperature). Matches the report_type evaluation_rule watches.']
  trading_date string [note: 'Business date of the compliance observation.']
  reading_count string [note: 'All intervals the device reported for the property on the day, any measurement_validity.']
  valid_reading_count string [note: 'Intervals with measurement_validity = valid and a non-NULL value. Denominator for the value statistics.']
  min_value string [note: 'Lowest valid reading of the day, in the measurement unit. Invalid, degraded and imputed intervals are excluded.']
  max_value string [note: 'Highest valid reading of the day, in the measurement unit. For a cold-chain upper limit this is the peak temperature.']
  avg_value string [note: 'Mean valid reading of the day: value_sum / valid_reading_count_for_avg.']
  value_sum string [note: 'Sum of valid readings. Carried with valid_reading_count_for_avg so the mean re-aggregates correctly at any grain.']
  valid_reading_count_for_avg string [note: 'Denominator of avg_value; equals valid_reading_count. Carried for transparent re-aggregation.']
  evaluation_rule_id string [note: 'Durable id of the current enabled rule this row is evaluated against. NULL when no current rule watches the device and …']
  condition_operator string [note: 'The comparison applied by the rule (e.g. greater_than, inside_range). NULL if no rule.']
  threshold_value string [note: 'Lower bound or single threshold from the rule, in the measurement unit. NULL if no rule.']
  threshold_value_upper string [note: 'Upper bound for inside_range or outside_range operators. NULL otherwise.']
  uom_code string [note: 'UN/CEFACT unit code (e.g. CEL for Celsius). From the rule when present.']
  time_window_seconds string [note: 'Sustained-breach window from the rule, carried for context. Not applied here: a single breaching interval counts.']
  evaluated_interval_count string [note: 'Valid intervals evaluated against a rule. Denominator of share_intervals_in_range; carried so the compliance rate …']
  breach_interval_count string [note: 'Valid intervals whose value satisfies the rule firing condition. Evaluated from the readings, independent of whether …']
  minutes_outside_range string [note: 'Sum of interval_minutes over breaching intervals: total minutes the asset was beyond the rule limit on the day.']
  share_intervals_in_range string [note: 'Share of evaluated valid intervals that did not breach: (evaluated - breaches) / evaluated. NULL when no rule applies …']
  is_compliant string [note: 'TRUE when no valid reading breached the rule on the day, FALSE when at least one did, NULL when no rule applies or …']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_css_excursion_episodes {
  store_id string [note: 'Durable store business key of the device that reported the episode.']
