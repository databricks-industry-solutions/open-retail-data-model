  dwell_seconds_total string [note: 'Disclosure-controlled dwell numerator. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  dwell_count string [note: 'Disclosure-controlled dwell denominator. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  avg_dwell_seconds string [note: 'Disclosure-controlled dwell_seconds_total / dwell_count. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  counting_unit string [note: 'What one published count represents: person, group, device or object.']
  staff_exclusion_enabled string [note: 'TRUE when staff were excluded from the operational count behind this shared row.']
  group_counting_enabled string [note: 'TRUE when shopping groups were counted as one.']
  time_mode string [note: 'Whether the underlying observations cover operating hours only or all day.']
  sensing_disclosure_policy_id string [note: 'Durable policy assignment whose effective version was resolved for this trading date.']
  disclosure_suppressed_flag string [note: 'TRUE when every traffic-derived measure in this cell is NULL under same-cell dependent-measure suppression.']
  aggregation_level string [note: 'Always site. Store footfall is not a sum of zone rows.']
  fresh_as_of_ts string [note: 'When the shared view was evaluated.']
  Note: 'gold · gold'
}

Table gold_traffic_sales_productivity_current {
  store_id string [note: 'Durable store business key.']
  trading_date string [note: 'Business date of the productivity observation.']
  fiscal_year string [note: 'NRF fiscal year for the trading date.']
  fiscal_week string [note: 'NRF fiscal week number within the fiscal year.']
  fiscal_week_id string [note: 'NRF fiscal week identifier.']
  fiscal_week_index string [note: 'Monotonic fiscal week index.']
  day_of_week string [note: 'ISO day of week for the trading date.']
  is_holiday string [note: 'TRUE when the trading date is a recognised retail holiday.']
  footfall_count string [note: 'Measured store footfall for the day. NOT a sum over zones.']
  entry_count string [note: 'Measured entries for the day.']
  exit_count string [note: 'Measured exits for the day. NULL when entry direction is not observed.']
  visitor_count_adjusted string [note: 'Footfall after staff exclusion.']
  avg_dwell_seconds string [note: 'Mean dwell duration in seconds.']
  dwell_seconds_total string [note: 'Sum of all dwell durations for re-aggregation.']
  dwell_count string [note: 'Count of dwell observations for re-aggregation.']
  peak_occupancy string [note: 'Highest simultaneous occupancy for the day.']
  avg_occupancy string [note: 'Duration-weighted mean simultaneous occupancy.']
  interval_minutes_total string [note: 'Total duration of valid traffic intervals.']
  occupancy_interval_minutes_total string [note: 'Duration of valid intervals with a reported occupancy average; denominator for re-aggregating avg_occupancy.']
  coverage_interval_minutes_total string [note: 'Duration of intervals with a reported coverage ratio; denominator for re-aggregating avg_coverage_ratio.']
  interval_count string [note: 'Number of intervals aggregated for the day.']
  footfall_count_py string [note: 'Footfall on the equivalent NRF fiscal week and weekday in the prior year.']
  footfall_growth_py string [note: 'Fractional growth: (footfall_count - footfall_count_py) / footfall_count_py.']
  units string [note: 'Units sold at the store-day. An item count, not a basket or transaction count.']
  gross_revenue string [note: 'Gross sales revenue before discounts at the store-day.']
  net_revenue string [note: 'Net revenue after discount, in the single reporting currency.']
  discount_amount string [note: 'Total discounts applied at the store-day.']
  currency_code string [note: 'ISO 4217 reporting currency.']
  promo_active_flag string [note: 'TRUE if any product at the store-day carried a real promotion; NO_PROMO is excluded.']
  active_promo_count string [note: 'Distinct real promotions active at the store-day.']
  sales_per_entry string [note: 'Net revenue divided by measured entries. A productivity measure, not conversion.']
  units_per_entry string [note: 'Items sold divided by measured entries. Items are not transactions.']
  sales_per_footfall string [note: 'Net revenue divided by measured footfall. Available when entry direction is not observed.']
  units_per_footfall string [note: 'Items sold divided by measured footfall. Items are not transactions.']
  counting_unit string [note: 'What one traffic count represents: person, group, device or object.']
  staff_exclusion_enabled string [note: 'TRUE if staff were excluded from the traffic count.']
  avg_coverage_ratio string [note: 'Mean share of expected traffic sensors that reported.']
  valid_interval_share string [note: 'Share of intervals whose traffic measurement was valid.']
  complete_interval_share string [note: 'Share of intervals where all data had fully landed.']
  is_zero_observed string [note: 'TRUE when footfall_count = 0 AND any interval carried is_zero_observed = TRUE.']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_unaccounted_exits {
  unaccounted_exit_id string [note: 'Durable unique identifier for the unaccounted exit event.']
  tagged_item_sk string [note: 'Serialized item surrogate key.']
  tagged_item_id string [note: 'Durable EPC Pure Identity URI (serialized item business key).']
  product_sk string [note: 'Product surrogate key.']
  product_id string [note: 'Durable product business key.']
  store_sk string [note: 'Store surrogate key.']
  store_id string [note: 'Durable store business key.']
  store_zone_sk string [note: 'Zone surrogate key where the exit was detected.']
  store_zone_id string [note: 'Durable zone business key where the exit was detected.']
  sensor_device_sk string [note: 'Device surrogate key that detected the exit.']
  sensor_device_id string [note: 'Durable device business key.']
  exit_event_ts string [note: 'UTC timestamp of the exit event.']
  trading_date string [note: 'Business date of the exit event.']
  direction_confidence string [note: 'Confidence score for the exit direction detection.']
  attribution_confidence string [note: 'Confidence score for the store-zone attribution.']
  disposition_uri string [note: 'GS1 CBV disposition URI (e.g. active, damaged, stolen).']
  biz_step_uri string [note: 'GS1 CBV business step URI describing the event context.']
  exception_reason string [note: 'Item-state reason only. This view contains no person, basket, receipt, loyalty, payment, or video link.']
  Note: 'gold · gold'
}

Table gold_zone_count_coverage {
  store_sk string [note: 'Store surrogate key.']
  store_id string [note: 'Durable store business key.']
  store_zone_sk string [note: 'Zone surrogate key.']
  store_zone_id string [note: 'Durable zone business key.']
  zone_code string [note: 'Zone code from the current dimension version.']
  zone_name string [note: 'Human-readable zone name.']
  zone_type string [note: 'Depth or role in the spatial hierarchy.']
  is_sales_floor string [note: 'TRUE when the zone is customer-accessible selling space.']
  last_counted_date string [note: 'Most recent trading_date on which this zone was covered by a count session.']
  days_since_last_count string [note: 'Calendar days between last_counted_date and fresh_as_of_ts.']
  target_cadence_days string [note: 'Configured reference cadence for RFID count sessions; the starter default is seven days.']
  is_overdue string [note: 'TRUE when days_since_last_count > target_cadence_days.']
  count_lookback_days string [note: 'Configured wall-clock lookback used by count_sessions_in_lookback; the starter default is 30 days.']
  count_sessions_in_lookback string [note: 'Distinct RFID count sessions observed within count_lookback_days.']
  lifetime_units_observed string [note: 'Cumulative distinct items ever observed in this zone across all sessions.']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_zone_item_presence_current {
  store_id string [note: 'Durable store business key.']
  store_zone_id string [note: 'Durable zone business key.']
  product_id string [note: 'Durable product business key.']
  units_present string [note: 'Count of distinct serialized items currently attributed as present in the zone.']
  oldest_supporting_event_ts string [note: 'Timestamp of the oldest read supporting current presence.']
  newest_supporting_event_ts string [note: 'Timestamp of the newest read supporting current presence.']
  max_freshness_age_minutes string [note: 'Minutes since the newest supporting event at the evaluation clock.']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_zone_traffic_current {
  store_id string [note: 'Durable store business key.']
  store_zone_id string [note: 'Durable zone business key -- the SCD2-safe join key. Prefer this over the surrogate.']
  latest_store_zone_sk string [note: 'Surrogate key of the zone version effective at the latest interval of the trading_date.']
  zone_code string [note: 'Zone code as emitted by the source system.']
  zone_name string [note: 'Human-readable zone name from the version effective at the latest interval.']
  zone_type string [note: 'Depth in the spatial hierarchy: entrance, area, department, aisle, bay, shelf_position, queue, fitting_room.']
  parent_zone_id string [note: 'Durable id of the containing zone.']
  hierarchy_depth string [note: 'Materialised depth (0 = site), so consumers avoid a recursive CTE.']
  is_sales_floor string [note: 'TRUE when the zone is customer-accessible selling space.']
  trading_date string [note: 'Business date of the zone traffic observation.']
  fiscal_year string [note: 'NRF fiscal year for the trading date.']
  fiscal_week_id string [note: 'NRF fiscal week identifier.']
  day_of_week string [note: 'ISO day of week for the trading date.']
  footfall_count string [note: 'Zone footfall for the day. Additive over TIME within the zone; NOT additive across zones.']
  entry_count string [note: 'Measured entries into the zone for the day.']
  exit_count string [note: 'Measured exits from the zone for the day. NULL when the zone sensors are non-directional.']
  passersby_count string [note: 'Pass-by traffic. Vendors define this two OPPOSITE ways (including or excluding entrants), so it is only comparable …']
  peak_occupancy string [note: 'Zone peak occupancy. A STORE peak is not the MAX of these -- it comes from the site row.']
  avg_occupancy string [note: 'Duration-weighted mean occupancy for the zone.']
  dwell_seconds_total string [note: 'Sum of dwell durations in the zone. Numerator for zone-level dwell re-aggregation.']
  dwell_count string [note: 'Count of distinct dwell observations in the zone. Denominator for zone-level dwell re-aggregation.']
  avg_dwell_seconds string [note: 'dwell_seconds_total / dwell_count for the zone-day.']
  engaged_count string [note: 'Dwell observations exceeding the engagement threshold.']
  passing_count string [note: 'Dwell observations below the engagement threshold. Distinct from passersby_count, which is storefront traffic rather …']
  engagement_rate string [note: 'engaged_count / dwell_count.']
  area_sqm_minutes string [note: 'Zone area multiplied by the duration of intervals where area was known; numerator for re-aggregating effective area.']
  area_interval_minutes_total string [note: 'Duration of intervals with a recorded zone area; denominator for area_sqm.']
  area_sqm string [note: 'Duration-weighted effective zone floor area in square metres for the zone-day.']
  capacity_persons string [note: 'Duration-weighted effective safe or design occupancy for the zone-day.']
  capacity_interval_minutes_total string [note: 'Duration of intervals with a recorded zone capacity; denominator for capacity_persons.']
  footfall_per_sqm string [note: 'Traffic density for THIS zone-day: footfall / area_sqm. Re-aggregating over several days divides by the summed area of …']
  occupancy_per_sqm string [note: 'Occupancy density: avg_occupancy / area_sqm.']
  peak_capacity_utilisation string [note: 'peak_occupancy / capacity_persons. Above 1 is either a safety event or a broken counter.']
  counting_unit string [note: 'What one count represents: person, group, device or object.']
  staff_exclusion_enabled string [note: 'TRUE if staff were excluded from the operational count behind this zone-day row.']
  avg_uptime_ratio string [note: 'Mean share of canonical interval duration the zone sensors were online.']
  avg_coverage_ratio string [note: 'Mean share of expected sensors that reported for the zone.']
  valid_interval_share string [note: 'Share of intervals whose measurement was valid for the zone.']
  is_zero_observed string [note: 'TRUE when footfall_count = 0 AND any interval carried is_zero_observed = TRUE.']
  interval_count string [note: 'Source intervals behind the zone-day aggregation.']
  interval_minutes_total string [note: 'Total duration of valid traffic intervals. This generic duration is not the denominator for measures reported on only …']
  occupancy_interval_minutes_total string [note: 'Duration of valid intervals with a reported occupancy average; the re-aggregation denominator for avg_occupancy.']
  uptime_interval_minutes_total string [note: 'Duration of intervals with a reported uptime ratio; the re-aggregation denominator for avg_uptime_ratio.']
  coverage_interval_minutes_total string [note: 'Duration of intervals with a reported coverage ratio; the re-aggregation denominator for avg_coverage_ratio.']
  aggregation_level string [note: 'Always area for this view. NEVER sum footfall across rows of this view to get a store total -- use …']
  fresh_as_of_ts string [note: 'When the view was evaluated.']
  Note: 'gold · gold'
}

Table gold_zone_traffic_interval_shared {
  shared_zone_traffic_interval_sk string [note: 'Deterministic hash of the disclosure-safe shared interval id; it contains no device identity.']
  shared_zone_traffic_interval_id string [note: 'Disclosure-safe interval id built from store, zone, UTC start epoch, and duration; it contains no device identity.']
  store_sk string [note: 'Store surrogate carried by the canonical interval.']
  store_id string [note: 'Durable store business key.']
  store_zone_id string [note: 'Durable zone business key.']
  zone_code string [note: 'Zone code from the exact dimension version referenced by the interval.']
  interval_start_ts string [note: 'UTC start instant of the published canonical interval.']
  interval_end_ts string [note: 'UTC end instant of the published canonical interval.']
  trading_date string [note: 'Business date used to resolve the effective disclosure policy.']
  interval_minutes string [note: 'Canonical interval duration. Rows below the policy minimum are omitted.']
  footfall_count string [note: 'Zone footfall for an interval that cleared the effective threshold. Suppressed intervals are omitted rather than …']
  dwell_seconds_total string [note: 'Dwell numerator for a disclosure-approved interval.']
  dwell_count string [note: 'Dwell denominator for a disclosure-approved interval.']
  avg_dwell_seconds string [note: 'dwell_seconds_total / dwell_count for a disclosure-approved interval.']
  sensing_disclosure_policy_id string [note: 'Durable policy assignment whose effective version admitted this interval.']
  Note: 'gold · gold'
}

Table gold_zone_traffic_shared {
  store_id string [note: 'Durable store business key.']
  store_zone_id string [note: 'Durable zone business key.']
  zone_code string [note: 'Zone code from the version effective for the measured intervals.']
  zone_name string [note: 'Human-readable zone name.']
  zone_type string [note: 'Depth or role of the zone in the in-store spatial hierarchy.']
  parent_zone_id string [note: 'Durable id of the containing zone.']
  hierarchy_depth string [note: 'Materialised zone depth, where zero is the site.']
  is_sales_floor string [note: 'TRUE when the zone is customer-accessible selling space.']
  trading_date string [note: 'Business date whose effective disclosure policy governs this shared cell.']
  fiscal_year string [note: 'NRF fiscal year for the trading date.']
  fiscal_week_id string [note: 'NRF fiscal week identifier.']
  day_of_week string [note: 'ISO day of week for the trading date.']
  footfall_count string [note: 'Disclosure-controlled zone footfall. NULL with disclosure_suppressed_flag = TRUE means suppressed, not zero.']
  entry_count string [note: 'Disclosure-controlled zone entries. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  exit_count string [note: 'Disclosure-controlled zone exits. NULL with disclosure_suppressed_flag = TRUE means suppressed; otherwise NULL can mean …']
  passersby_count string [note: 'Disclosure-controlled pass-by traffic. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  peak_occupancy string [note: 'Disclosure-controlled zone peak occupancy. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  avg_occupancy string [note: 'Disclosure-controlled duration-weighted mean occupancy. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  dwell_seconds_total string [note: 'Disclosure-controlled dwell numerator. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  dwell_count string [note: 'Disclosure-controlled dwell denominator. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  avg_dwell_seconds string [note: 'Disclosure-controlled dwell_seconds_total / dwell_count. NULL with disclosure_suppressed_flag = TRUE means suppressed.']
  engaged_count string [note: 'Disclosure-controlled dwell observations at or above the engagement threshold.']
  passing_count string [note: 'Disclosure-controlled dwell observations below the engagement threshold.']
  engagement_rate string [note: 'Disclosure-controlled engaged_count / dwell_count.']
  footfall_per_sqm string [note: 'Disclosure-controlled daily zone traffic density.']
  occupancy_per_sqm string [note: 'Disclosure-controlled mean occupancy density.']
  peak_capacity_utilisation string [note: 'Disclosure-controlled peak occupancy as a share of effective capacity.']
  area_sqm string [note: 'Duration-weighted effective zone area. This non-traffic dimension remains visible when traffic measures are suppressed.']
  capacity_persons string [note: 'Duration-weighted effective zone capacity. This non-traffic dimension remains visible when traffic measures are …']
  counting_unit string [note: 'What one published count represents: person, group, device or object.']
  staff_exclusion_enabled string [note: 'TRUE when staff were excluded from the operational count behind this shared row.']
  sensing_disclosure_policy_id string [note: 'Durable policy assignment whose effective version was resolved for this trading date.']
  disclosure_suppressed_flag string [note: 'TRUE when every traffic-derived measure in this cell is NULL under same-cell dependent-measure suppression.']
  aggregation_level string [note: 'Always area. Zone footfall is not additive across zones.']
  fresh_as_of_ts string [note: 'When the shared view was evaluated.']
  Note: 'gold · gold'
}

