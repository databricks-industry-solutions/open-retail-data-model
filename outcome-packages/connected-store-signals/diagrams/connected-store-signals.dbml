  store_timezone string [note: 'IANA store timezone used to derive local business fields.']
  utc_offset_minutes smallint [not null, note: 'Store UTC offset in minutes at observation_ts.']
  trading_date date [not null, note: 'Business date of observation_ts. Logical join to fiscal_calendar.date_key.']
  hour_of_day tinyint [note: 'Store-local observation hour, 0 through 23.']
  shelf_state string [not null, note: 'Evaluated state at capture: in_stock, low_stock, out_of_stock, misplaced, unknown. low_stock uses min_facing_threshold …']
