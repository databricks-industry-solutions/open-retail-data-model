  shelf_position_assignment_id string [note: 'Durable assignment key captured at observation time, so compliance stays evaluable after the assignment re-versions …']
  store_sk bigint [not null, note: 'FK to the store version in effect at observation time.']
  store_id string [not null, note: 'Durable store business key.']
  store_zone_sk bigint [not null, note: 'FK to the shelf-position zone version observed.']
  store_zone_id string [not null, note: 'Durable shelf-position zone id (store_zone.zone_type = shelf_position).']
