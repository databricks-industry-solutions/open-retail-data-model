  rfid_count_session_id string [note: 'Latest session selected within the store, product, reconciliation date, and basis.']
  session_trading_date string [note: 'Business date of the latest session selected for this store-product-reconciliation_date.']
  session_end_local_date string [note: 'Session end date in store local time.']
  scope_type string [note: 'Count scope of the latest session: full_store or partial.']
  eligible_tagged_units string [note: 'Distinct active serialized units eligible for the count.']
  observed_units string [note: 'Distinct items observed in the latest session for this product.']
  book_units_eod string [note: 'End-of-day book units at reconciliation_date.']
