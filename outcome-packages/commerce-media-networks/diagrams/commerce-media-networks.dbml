  cell_name string [note: 'Human-readable cell name.']
  cell_role string [note: 'Role of the cell in the design. Allowed values: treatment, control, holdout.']
  traffic_allocation_pct decimal(5,2) [note: 'Share of assignment units allocated to this cell (0-100).']
  is_control boolean [note: 'TRUE if this is the control/counterfactual cell.']
  effective_from_date date [not null, note: 'SCD2: inclusive start date this version became effective.']
  effective_to_date date [note: 'SCD2: exclusive end date; NULL for the current version.']
  is_current boolean [not null, note: 'SCD2: TRUE for the currently active version of this cell.']
  created_timestamp timestamp [note: 'When the record was created in the source system (UTC, ISO 8601).']
  source_updated_timestamp timestamp [note: 'When the record was last modified in the source system (UTC, ISO 8601).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
  Note: 'master · silver'
}

