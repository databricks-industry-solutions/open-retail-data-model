Table incrementality_result {
  incrementality_result_sk bigint [pk, note: 'Surrogate key.']
  incrementality_result_id string [not null, note: 'Durable natural/business key for the result.']
  experiment_sk bigint [note: 'FK to cmn.experiment.experiment_sk.']
  experiment_id string [note: 'Durable experiment business key.']
  treatment_cell_sk bigint [note: 'FK to cmn.experiment_cell.experiment_cell_sk — the treatment cell.']
  treatment_cell_id string [note: 'Durable treatment-cell business key.']
  control_cell_sk bigint [note: 'FK to cmn.experiment_cell.experiment_cell_sk — the control cell.']
  control_cell_id string [note: 'Durable control-cell business key.']
  campaign_sk bigint [note: 'FK to cmn.campaign.campaign_sk (the campaign under test).']
  campaign_id string [note: 'Durable campaign business key.']
  advertiser_sk bigint [note: 'FK to cmn.advertiser.advertiser_sk.']
  advertiser_id string [note: 'Durable advertiser business key.']
  product_sk bigint [note: 'FK to product.product_sk (or ALL for overall).']
  product_id string [note: 'Durable product business key; ALL when not applicable.']
  snapshot_date date [not null, note: 'Measurement snapshot date (cluster key).']
  metric_name string [not null, note: 'Metric evaluated. Allowed values: incremental_sales, incremental_units, roas, conversion_rate, reach.']
  analysis_level string [note: 'Slice level of the result. Allowed values: overall, store, geo, product, category, vendor.']
  observed_treatment_value decimal(18,4) [note: 'Observed metric value in the treatment cell.']
  observed_control_value decimal(18,4) [note: 'Observed metric value in the control cell.']
  counterfactual_value decimal(18,4) [note: 'Estimated counterfactual (what treatment would have been without media).']
  incremental_sales_amount decimal(18,2) [note: 'Incremental sales, in the reporting/base currency.']
  incremental_margin_amount decimal(18,2) [note: 'Incremental margin, in the reporting/base currency.']
  media_spend_amount decimal(18,2) [note: 'Media spend attributed to the treatment, in the reporting/base currency.']
  currency_code string [note: 'Amount currency, ISO 4217 alpha-3 (single reporting currency).']
  lift_pct decimal(9,4) [note: 'Relative lift of treatment over control, percent.']
  iroas_value decimal(12,4) [note: 'Incremental ROAS = incremental_sales / media_spend.']
  confidence_level_pct decimal(5,2) [note: 'Confidence level of the interval, percent (e.g. 95.00).']
  ci_lower_value decimal(18,4) [note: 'Lower bound of the confidence interval for the estimate.']
  ci_upper_value decimal(18,4) [note: 'Upper bound of the confidence interval for the estimate.']
  p_value decimal(9,6) [note: 'p-value of the treatment-vs-control test.']
  statistical_significance_flag boolean [note: 'TRUE if the result is statistically significant at the confidence level.']
  sample_size_treatment bigint [note: 'Treatment-cell sample size.']
  sample_size_control bigint [note: 'Control-cell sample size.']
  methodology string [note: 'Causal method used. Allowed values: randomized_control, matched_market, synthetic_control, difference_in_differences …']
  suppressed_flag boolean [note: 'TRUE if suppressed for disclosure (below threshold / policy).']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
  Note: 'transactional · silver'
}

