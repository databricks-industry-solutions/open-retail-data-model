  household_key_hash string [note: 'PII · Hashed/tokenized household identifier (PII, never raw).']
  consent_status string [note: 'Consent state for measurement at event time. Allowed values: granted, denied, unknown.']
  record_source string [note: 'Originating system of record (vendor-neutral label).']
  load_timestamp timestamp [note: 'When this row was loaded (UTC, ISO 8601).']
