  retailer_value_net string [note: 'Latest retailer-submitted net value for the week, reporting/base currency.']
  supplier_value_net string [note: 'Latest supplier-submitted net value for the week, reporting/base currency.']
  consensus_value_net string [note: 'Agreed consensus net value, reporting/base currency.']
  currency_code string [note: 'Amount currency, ISO 4217 alpha-3.']
  statistical_forecast_qty string [note: 'Statistical demand baseline from the Smarter Demand package, allocated to this supplier by its demand share of the …']
  plan_variance_pct string [note: 'Retailer-vs-supplier disagreement recomputed LIVE from the latest submissions = (retailer_qty - supplier_qty) / …']
  consensus_vs_baseline_pct string [note: 'Consensus lift over the statistical baseline = (consensus_qty - statistical_forecast_qty) / statistical_forecast_qty.']
  fresh_as_of_ts string [note: 'View evaluation timestamp (UTC).']
  Note: 'gold · gold'
}

