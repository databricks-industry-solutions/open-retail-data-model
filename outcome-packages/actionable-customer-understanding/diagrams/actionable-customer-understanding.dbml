  category string [note: 'Merchandising category (current version; label only).']
  subcategory string [note: 'Merchandising subcategory (current version; label only).']
  brand string [note: 'Brand (current version; label only).']
  purchase_count string [note: 'Distinct orders (purchase occasions) the customer bought this product on.']
  total_units string [note: 'Total units of this product the customer purchased.']
  total_net_amount string [note: 'Total net spend on this product, in the reporting/base currency.']
  currency_code string [note: 'Reporting/base currency of total_net_amount (ISO 4217).']
  first_purchase_date string [note: 'Date of the customer\'s first purchase of this product.']
  last_purchase_date string [note: 'Date of the customer\'s most recent purchase of this product.']
  last_purchased_at string [note: 'Event-time (UTC) of the customer\'s most recent PURCHASE of this product (MAX event_timestamp) — carries time-of-day …']
  days_since_last_purchase string [note: 'Days from the last purchase to as_of_date (MAX(order_date) in the data) — the input to recency decay.']
  recency_weight string [note: 'Exponential time-decay weight pow(0.5, days_since_last_purchase / 90) in (0,1]. Half-life 90 days.']
  affinity_score string [note: 'Purchase-history affinity in [0,1] = LEAST(1, purchase_intensity x recency_weight); purchase_intensity = LEAST(1 …']
  affinity_band string [note: 'Coarse affinity bucket: high (>= 0.6) / medium (>= 0.2) / low.']
  primary_driver string [note: 'What the affinity is derived from. v1 is always PURCHASE_HISTORY; BROWSE_BEHAVIOR and latent/embedding (ML) drivers are …']
  Note: 'gold · gold'
}

Table gold_market_share {
  benchmark_cell_id string [note: 'Stable logical cell identity shared across original and restated deliveries.']
  market_benchmark_id string [note: 'Current delivered-version identity selected for the stable benchmark cell.']
  source_observation_id string [note: 'Source identity of the selected delivered cell version.']
  record_source string [note: 'Licensed benchmark source namespace; methodology and usage rights remain source-specific.']
  market_definition string [note: 'Measured store/channel universe supplied by the source; a share number is not meaningful without it.']
  geography_level string [note: 'Provider geography hierarchy level: total, region, market, key_account or account_market.']
  geography_code string [note: 'Provider or adopter identifier at geography_level.']
  category_ref string [note: 'Adopter-owned mapping from the benchmark category to the own merchandising hierarchy.']
  subject_type string [note: 'Served subject: own banner, competitor banner, brand or private label; total-category cells are denominator-only inputs.']
  subject_id string [note: 'Source identifier for the served non-total subject.']
  competitor_id string [note: 'Durable BMV competitor key when a competitor-banner subject is mapped.']
  competitor_name string [note: 'Competitor display name effective at provider period end.']
  period_type string [note: 'Provider period vocabulary; never relabeled as an own fiscal period.']
  period_end_date string [note: 'Provider-defined period end date used for stable-cell grain and period-end display-name resolution.']
  currency_code string [note: 'ISO 4217 reporting currency for benchmark monetary measures.']
  market_share_sales_amount string [note: 'Additive measured sales for this subject cell; numerator for market share.']
  market_size_sales_amount string [note: 'Matching total-category sales; denominator for market share.']
  subject_unit_volume string [note: 'Measured unit volume for the selected subject cell.']
  market_size_unit_volume string [note: 'Matching total-category unit volume.']
  market_share_pct string [note: '100 x subject sales / matching total-category sales. NULL when the denominator cell is unavailable.']
  provider_reported_market_share_pct string [note: 'Provider-reported share retained for reconciliation; non-additive and not averaged by the metric view.']
  provider_reported_market_growth_rate_pct string [note: 'Provider-reported growth retained without recomputation across restatements.']
  eq_volume string [note: 'Optional provider-supplied equivalized volume.']
  acv_weighted_distribution_pct string [note: 'Optional provider-supplied importance-weighted distribution percentage; non-additive.']
  numeric_distribution_pct string [note: 'Optional provider-supplied outlet-count-weighted distribution percentage; non-additive.']
  tdp string [note: 'Optional provider-supplied total distribution points.']
  promo_sales_amount string [note: 'Optional provider-supplied sales attributed to promotional conditions.']
  base_sales_amount string [note: 'Optional provider-supplied sales attributed to base conditions.']
  is_restatement string [note: 'TRUE when the selected current delivery revised an earlier version of the stable cell.']
  restates_market_benchmark_id string [note: 'Delivered-version key superseded by the selected restatement, when supplied.']
  observed_at_ts string [note: 'Provider observation or publication timestamp for the selected version.']
  provider_updated_at_ts string [note: 'Provider update timestamp used first in latest-wins ordering.']
  load_timestamp string [note: 'Lakehouse load timestamp used after provider and observation timestamps in latest-wins ordering.']
  market_share_basis string [note: 'Ratio basis used by the metric view: subject sales over matching total-category sales.']
  license_posture string [note: 'Default internal-use-only boundary for licensed cells and their derivatives; adopters apply their own contracts.']
  Note: 'gold · gold'
}

Table gold_product_affinity_pairwise {
  product_affinity_id string [note: 'Durable grain key for the directed pair: product_id_a|product_id_b|time_window.']
  product_id_a string [note: 'Antecedent product (the durable business key). The "if a customer buys A" side.']
  product_name_a string [note: 'Display name of product A (current product version; label only).']
  category_a string [note: 'Merchandising category of product A (current version; label only).']
  brand_a string [note: 'Brand of product A (current version; label only).']
  product_id_b string [note: 'Consequent product (the durable business key). The "...they also buy B" side.']
  product_name_b string [note: 'Display name of product B (current product version; label only).']
  category_b string [note: 'Merchandising category of product B (current version; label only).']
  brand_b string [note: 'Brand of product B (current version; label only).']
  time_window string [note: 'The trailing window the rule was computed over: 30D / 90D / ALL_TIME, each anchored to MAX(order_date) (not …']
  computed_through_date string [note: 'The anchor the trailing windows trail from: MAX(order_date) in the data (same value on every row). A 30D row therefore …']
  cooccurrence_baskets string [note: 'Baskets (orders) containing BOTH A and B — the numerator for support and confidence.']
  antecedent_baskets string [note: 'Baskets containing A (the confidence denominator).']
  consequent_baskets string [note: 'Baskets containing B.']
  total_baskets string [note: 'Distinct baskets (orders) in the window — the support denominator.']
  support string [note: 'Support = cooccurrence_baskets / total_baskets: how common the pair is across all baskets (0..1).']
  confidence string [note: 'Confidence(A->B) = cooccurrence_baskets / antecedent_baskets: P(B in basket | A in basket) (0..1). Directional.']
  lift string [note: 'Lift = support(A,B) / (support(A) x support(B)): association strength vs. chance. > 1 = positive/meaningful, = 1 = …']
  is_mirrored_pair string [note: 'TRUE on the mirror copy (product_id_a > product_id_b). Filter to FALSE for one row per undirected pair; keep both for …']
  Note: 'gold · gold'
}

